# Optional settings for `docker compose up`.
#
# Copy to `.env` in this folder to override. Compose reads that file
# automatically; every value below has a working fallback in
# docker-compose.yml, so this file is not required to start the stack.
#
# This is for the CONTAINERS. Running the API directly on your machine instead
# uses api/.env — a different file.

POSTGRES_PASSWORD=postgres

# Host port for the containerised API. The default collides with `npm run dev`
# in api/, which also uses 4000 -- set this to 4001 when you want the compose
# stack and the local dev server running side by side.
# API_HOST_PORT=4001

# Signs the session cookie. Generate a real one for anything shared:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=dev-only-compose-secret-change-me
