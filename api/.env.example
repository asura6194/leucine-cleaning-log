# Local PostgreSQL (the QA environment you browse in DBeaver).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cleaning_log

# Set to require/prefer when pointing at a managed host (Supabase, RDS).
# Leave as disable for a local server.
PGSSLMODE=disable
PORT=4000
JWT_SECRET=generate-a-long-random-string
SESSION_TTL_SECONDS=28800
CORS_ORIGIN=http://localhost:5173
